{% extends "main.j2" %}
{% block content %}
<h2>Magic Categories</h2>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>1</td><td>Transfiguration</td><td><button>Delete</button></td></tr>
    </tbody>
</table>

<h3>Add Category</h3>
<form action="/categories" method="POST">
    <input type="text" name="categoryName" placeholder="Category Name" required>
    <input type="submit" value="Add Category">
</form>

<h3>Update Category</h3>
<form action="/update-category" method="POST">
    <select name="categoryID"><option value="1">Transfiguration</option></select>
    <input type="text" name="categoryName" placeholder="New Name">
    <input type="submit" value="Update Category">
</form>
{% endblock %}