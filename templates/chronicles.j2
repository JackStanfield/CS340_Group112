{% extends "main.j2" %}
{% block content %}

<h1>Chronicles</h1>

<h2>Browse Chronicles</h2>

{% if chronicles and chronicles|length > 0 %}
<table>
  <thead>
    <tr>
      <th>chronicleID</th>
      <th>chronicleTitle</th>
      <th>publicationDate</th>
      <th>description</th>
      <th>wizardName</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    {% for c in chronicles %}
    <tr>
      <td>{{ c.chronicleID }}</td>
      <td>{{ c.chronicleTitle }}</td>
      <td>{{ c.publicationDate | default('', true) }}</td>
      <td>{{ c.description | default('', true) }}</td>
      <td>{{ c.wizardName | default('', true) }}</td>

      {# DELETE placeholder (not wired yet) #}
      <form id="delete_chronicle_form">
        <input type="hidden" name="delete_chronicle_id" value="{{ c.chronicleID }}">
        <td><button type="submit">Delete</button></td>
      </form>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p>No chronicles found.</p>
{% endif %}


<h2>Add Chronicle</h2>
<form class="cuForm" id="create_chronicle_form">
  <label for="chronicleTitle">Title:</label>
  <input type="text" id="chronicleTitle" name="chronicleTitle" required>

  <label for="publicationDate">Publication Date:</label>
  <input type="date" id="publicationDate" name="publicationDate">

  <label for="description">Description:</label>
  <textarea id="description" name="description"></textarea>

  <label for="wizardID">Author Wizard:</label>
  <select id="wizardID" name="wizardID">
    <option value="NULL" selected>Unknown</option>
    {% for w in wizards %}
      <option value="{{ w.wizardID }}">{{ w.wizardID }} - {{ w.wizardName }}</option>
    {% endfor %}
  </select>

  <button type="submit">Add Chronicle</button>
</form>


<h2>Update Chronicle</h2>
<form class="cuForm" id="update_chronicle_form">
  <label for="update_chronicleID">Chronicle:</label>
  <select id="update_chronicleID" name="chronicleID" required>
    <option value="" disabled selected>Select chronicle</option>
    {% for c in chronicles %}
      <option value="{{ c.chronicleID }}">{{ c.chronicleID }} - {{ c.chronicleTitle }}</option>
    {% endfor %}
  </select>

  <label for="update_chronicleTitle">New Title:</label>
  <input type="text" id="update_chronicleTitle" name="chronicleTitle">

  <label for="update_publicationDate">New Publication Date:</label>
  <input type="date" id="update_publicationDate" name="publicationDate">

  <label for="update_description">New Description:</label>
  <textarea id="update_description" name="description"></textarea>

  <label for="update_wizardID">New Author:</label>
  <select id="update_wizardID" name="wizardID">
    <option value="NULL" selected>Unknown</option>
    {% for w in wizards %}
      <option value="{{ w.wizardID }}">{{ w.wizardID }} - {{ w.wizardName }}</option>
    {% endfor %}
  </select>

  <button type="submit">Update Chronicle</button>
</form>

{% endblock %}