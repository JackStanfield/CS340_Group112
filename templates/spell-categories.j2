{% extends "main.j2" %}
{% block content %}
<h2>Spell Categories (Intersection Table)</h2>
<p>Manage which spells belong to which categories.</p>

{% if spell_categories and spell_categories|length > 0 %}
<table>
    <thead>
        <tr>
            <th>spellCategoryID</th><th>spellName</th><th>categoryName</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for sc in spell_categories %}
        <tr>
            <td>{{ sc.spellCategoryID }}</td><td>{{ sc.spellName }}</td><td>{{ sc.categoryName }}</td>
            <td>
                <form action="/delete-spell-category/{{ sc.spellID }}/{{ sc.categoryID }}" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('Remove this category from the spell?');">Delete Association</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<p>No spell-category associations found.</p>
{% endif %}

<h3>Link Spell to Category</h3>
<form class="cuForm" id="create_spell_category_form" action="/spell-categories" method="POST">
    <label for="spell_select">Spell:</label>
    <select name="spellID" id="spell_select" required>
        <option value="" disabled selected>Select spell</option>
        {% for s in spells %}
        <option value="{{ s.spellID }}">{{ s.spellID }} - {{ s.spellName }}</option>
        {% endfor %}
    </select>

    <label for="category_select">Category:</label>
    <select name="categoryID" id="category_select" required>
        <option value="" disabled selected>Select category</option>
        {% for c in categories %}
        <option value="{{ c.categoryID }}">{{ c.categoryID }} - {{ c.categoryName }}</option>
        {% endfor %}
    </select>
    <input type="submit" value="Link Spell to Category">
</form>

<hr>

<h3>Update a Spell-Category Relationship (Update)</h3>
<form class="cuForm" id="update_spell_category_form" action="/update-spell-category" method="POST">
    <label for="update_rel_select">Select Relationship to Update:</label>
    <select name="spellCategoryID" id="update_rel_select" required>
        <option value="" disabled selected>Select an existing link</option>
        {% for rel in spell_categories %}
            <option value="{{ rel.spellCategoryID }}">{{ rel.spellName }} - {{ rel.categoryName }}</option>
        {% endfor %}
    </select>
    
    <label for="update_spell_select">New Spell:</label>
    <select name="spellID" id="update_spell_select" required>
        <option value="" disabled selected>Select new spell</option>
        {% for spell in spells %}
            <option value="{{ spell.spellID }}">{{ spell.spellName }}</option>
        {% endfor %}
    </select>

    <label for="update_category_select">New Category:</label>
    <select name="categoryID" id="update_category_select" required>
        <option value="" disabled selected>Select new category</option>
        {% for cat in categories %}
            <option value="{{ cat.categoryID }}">{{ cat.categoryName }}</option>
        {% endfor %}
    </select>

    <input type="submit" value="Update Relationship">
</form>
{% endblock %}