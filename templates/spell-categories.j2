{% extends "main.j2" %}
{% block content %}

<h2>Spell Categories (Intersection Table)</h2>
<p>Manage which spells belong to which categories.</p>

{% if spell_categories and spell_categories|length > 0 %}
<table>
    <thead>
        <tr>
            <th>spellCategoryID</th>
            <th>spellName</th>
            <th>categoryName</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {% for sc in spell_categories %}
        <tr>
            <td>{{ sc.spellCategoryID }}</td>
            <td>{{ sc.spellName }}</td>
            <td>{{ sc.categoryName }}</td>

            {# DELETE placeholder (not wired yet) #}
            <form id="delete_spell_category_form">
                <input type="hidden" name="delete_spellCategoryID" value="{{ sc.spellCategoryID }}">
                <td><button type="submit">Delete Association</button></td>
            </form>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<p>No spell-category associations found.</p>
{% endif %}

<h3>Link Spell to Category</h3>
<form class="cuForm" id="create_spell_category_form">
    <label for="spell_select">Spell:</label>
    <select name="spellID" id="spell_select" required>
        <option value="" disabled selected>Select spell</option>
        {% for s in spells %}
        <option value="{{ s.spellID }}">{{ s.spellID }} - {{ s.spellName }}</option>
        {% endfor %}
    </select>

    <label for="category_select">Category:</label>
    <select name="categoryID" id="category_select" required>
        <option value="" disabled selected>Select category</option>
        {% for c in categories %}
        <option value="{{ c.categoryID }}">{{ c.categoryID }} - {{ c.categoryName }}</option>
        {% endfor %}
    </select>

    <input type="submit" value="Link Spell to Category">
</form>

{% endblock %}