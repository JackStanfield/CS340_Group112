{% extends "main.j2" %}
{% block content %}

<h1>Wizards</h1>

<h2>Browse Wizards</h2>

{# Guard against empty result set so people[0] pattern doesn't crash #}
{% if wizards and wizards|length > 0 %}
<table>
  <thead>
    <tr>
      {# auto header from keys (like the BSG example) #}
      {% for key in wizards[0].keys() %}
        <th>{{ key }}</th>
      {% endfor %}
      <th></th>
    </tr>
  </thead>

  <tbody>
    {% for w in wizards %}
    <tr>
      <td>{{ w.wizardID }}</td>
      <td>{{ w.wizardName }}</td>
      <td>{{ w.beardLengthCm | default('', true) }}</td>
      <td>{{ w.wizardAge | default('', true) }}</td>

      {# Display master name if present; otherwise blank #}
      <td>{{ w.masterName | default('', true) }}</td>

      {# Optional placeholder delete button (not wired yet) #}
      <form id="delete_wizard_form">
        <input type="hidden" name="delete_wizard_id" value="{{ w.wizardID }}">
        <td><button type="submit">Delete</button></td>
      </form>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
  <p>No wizards found.</p>
{% endif %}


<h2>Add Wizard</h2>

<form class="cuForm" id="create_wizard_form">
  <label for="wizardName">Wizard Name:</label>
  <input type="text" id="wizardName" name="wizardName" required>

  <label for="beardLengthCm">Beard Length (cm):</label>
  <input type="number" id="beardLengthCm" name="beardLengthCm" min="0">

  <label for="wizardAge">Wizard Age:</label>
  <input type="number" id="wizardAge" name="wizardAge" min="0">

  <label for="masterID">Master:</label>
  <select id="masterID" name="masterID">
    <option value="NULL" selected>&lt; None &gt;</option>
    {% for m in masters %}
      <option value="{{ m.wizardID }}">{{ m.wizardID }} - {{ m.wizardName }}</option>
    {% endfor %}
  </select>

  <button type="submit">Add Wizard</button>
</form>


<h2>Update Wizard</h2>

<form class="cuForm" id="update_wizard_form">
  <label for="updateWizardID">Wizard to Update:</label>
  <select id="updateWizardID" name="wizardID" required>
    <option value="" disabled selected>Select wizard</option>
    {% for w in wizards %}
      <option value="{{ w.wizardID }}">{{ w.wizardID }} - {{ w.wizardName }}</option>
    {% endfor %}
  </select>

  <label for="updateWizardName">New Wizard Name:</label>
  <input type="text" id="updateWizardName" name="wizardName">

  <label for="updateBeardLengthCm">New Beard Length (cm):</label>
  <input type="number" id="updateBeardLengthCm" name="beardLengthCm" min="0">

  <label for="updateWizardAge">New Wizard Age:</label>
  <input type="number" id="updateWizardAge" name="wizardAge" min="0">

  <label for="updateMasterID">New Master:</label>
  <select id="updateMasterID" name="masterID">
    <option value="NULL" selected>&lt; None &gt;</option>
    {% for m in masters %}
      <option value="{{ m.wizardID }}">{{ m.wizardID }} - {{ m.wizardName }}</option>
    {% endfor %}
  </select>

  <button type="submit">Update Wizard</button>
</form>

{% endblock %}