{% extends "main.j2" %}
{% block content %}
<h2>Spells</h2>

{% if spells and spells|length > 0 %}
<table>
    <thead>
        <tr>
            <th>spellID</th><th>spellName</th><th>castingInstruction</th><th>chronicleTitle</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for s in spells %}
        <tr>
            <td>{{ s.spellID }}</td><td>{{ s.spellName }}</td>
            <td>{{ s.castingInstruction | default('', true) }}</td>
            <td>{{ s.chronicleTitle | default('', true) }}</td>
            <td>
                <form action="/delete-spell/{{ s.spellID }}" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('Are you sure you want to delete this spell?');">Delete</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<p>No spells found.</p>
{% endif %}

<h3>Add New Spell</h3>
<form class="cuForm" id="create_spell_form" action="/spells" method="POST">
    <label for="create_spellName">Name:</label>
    <input type="text" id="create_spellName" name="spellName" required>

    <label for="create_castingInstruction">Instructions:</label>
    <textarea id="create_castingInstruction" name="castingInstruction"></textarea>

    <label for="create_chronicleID">Chronicle:</label>
    <select id="create_chronicleID" name="chronicleID" required>
        <option value="" disabled selected>Select chronicle</option>
        {% for c in chronicles %}
        <option value="{{ c.chronicleID }}">{{ c.chronicleID }} - {{ c.chronicleTitle }}</option>
        {% endfor %}
    </select>
    <input type="submit" value="Add Spell">
</form>

<h3>Update Spell</h3>
<form class="cuForm" id="update_spell_form" action="/update-spell" method="POST">
    <label for="update_spellID">Spell to Update:</label>
    <select id="update_spellID" name="spellID" required>
        <option value="" disabled selected>Select spell</option>
        {% for s in spells %}
        <option value="{{ s.spellID }}">{{ s.spellID }} - {{ s.spellName }}</option>
        {% endfor %}
    </select>
    <label for="update_spellName">New Name:</label>
    <input type="text" id="update_spellName" name="spellName">
    <label for="update_castingInstruction">New Instructions:</label>
    <textarea id="update_castingInstruction" name="castingInstruction"></textarea>
    <label for="update_chronicleID">New Chronicle:</label>
    <select id="update_chronicleID" name="chronicleID">
        <option value="" disabled selected>Select chronicle</option>
        {% for c in chronicles %}
        <option value="{{ c.chronicleID }}">{{ c.chronicleID }} - {{ c.chronicleTitle }}</option>
        {% endfor %}
    </select>
    <input type="submit" value="Update Spell">
</form>
{% endblock %}