{% extends "main.j2" %}
{% block content %}
<h2>Spells</h2>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Instructions</th>
            <th>Chronicle</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>1</td>
            <td>Fireball</td>
            <td>Raise your hand toward the target...</td>
            <td>Ancient Text I</td>
            <td><button>Delete</button></td>
        </tr>
    </tbody>
</table>

<h3>Add New Spell</h3>
<form action="/spells" method="POST">
    <label>Name:</label><input type="text" name="spellName" required>
    <label>Instructions:</label><textarea name="instructionInput"></textarea>
    <label>Chronicle:</label>
    <select name="chronicleID">
        <option value="1">Ancient Text I</option>
    </select>
    <input type="submit" value="Add Spell">
</form>

<h3>Update Spell</h3>
<form action="/update-spell" method="POST">
    <label>Spell to Update:</label>
    <select name="spellID">
        <option value="1">Fireball</option>
    </select>
    <label>New Name:</label><input type="text" name="spellName">
    <label>New Chronicle:</label>
    <select name="chronicleID">
        <option value="1">Ancient Text I</option>
    </select>
    <input type="submit" value="Update Spell">
</form>
{% endblock %}